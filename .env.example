# Environment Variables Reference (DO NOT COMMIT ACTUAL SECRETS)
# Copy to .env.local or export in your shell environment as needed.

# Google Gemini / AI Studio API Key
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (optional if using `gh auth login`)
GITHUB_TOKEN=your_github_pat_here

# Rclone Google Drive OAuth Client Credentials
# Reference: https://rclone.org/drive/#making-your-own-client
RCLONE_DRIVE_CLIENT_ID=your_google_oauth_client_id_here
RCLONE_DRIVE_CLIENT_SECRET=your_google_oauth_client_secret_here
